# Laburator — Job Search CLI Configuration
# Copy this file to .env and fill in your values.

# Required: API key for the LLM provider (OpenAI-compatible)
MODEL_API_KEY=

# API endpoint URL (OpenAI-compatible chat completions API)
MODEL_API_ENDPOINT=https://opencode.ai/zen/v1

# LLM model to use for job processing
MODEL_NAME=deepseek-v4-flash-free

# Job search source/provider (default: openninja)
# Available: openninja, arbeitnow, remotive, jobicy, apify_linkedin, apify_indeed
JOB_SEARCH_SOURCE=openninja

# OpenNinja (jsearch) - requires key
JOB_SEARCH_API_KEY=

# Apify - API token shared by Apify sources (required when source=apify_linkedin or apify_indeed)
# Uses free credits if available ($5 credit noted), then paid per run; see provider files for limits/cost.
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=bebity/linkedin-jobs-scraper
APIFY_INDEED_ACTOR_ID=valig/indeed-jobs-scraper

# ── Paths (defaults) ────────────────────────────────────────────────────
# Path to your CV/resume markdown file
CV_PATH=cv.md

# Directory containing LLM Wiki knowledge base
LLMWIKI_DIR=../llmwiki/wiki

# Output directory for generated files
OUTPUT_DIR=~/.local/share/laburator/output
