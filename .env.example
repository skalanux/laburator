# Laburator — Job Search CLI Configuration
# Copy this file to .env and fill in your values.

# Required: API key for the LLM provider (OpenAI-compatible)
MODEL_API_KEY=

# API endpoint URL (OpenAI-compatible chat completions API)
MODEL_API_ENDPOINT=https://opencode.ai/zen/v1

# LLM model to use for job processing
MODEL_NAME=deepseek-v4-flash-free

# API key for the job search API (openwebninja.com/jsearch)
JOB_SEARCH_API_KEY=

# ── Paths (defaults) ────────────────────────────────────────────────────
# Path to your CV/resume markdown file
CV_PATH=cv.md

# Directory containing LLM Wiki knowledge base
LLMWIKI_DIR=../llmwiki/wiki

# Output directory for generated files
OUTPUT_DIR=~/.local/share/laburator/output
